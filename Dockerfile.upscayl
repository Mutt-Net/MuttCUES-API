FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip libvulkan1 vulkan-tools libgomp1 \
        unzip curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Prebuilt realesrgan-ncnn-vulkan + bundled models.
# UPSCAYL_NCNN_URL is the upscayl-ncnn Linux release zip (confirm the current
# asset before building — see plan Task 6 Step 1).
ARG UPSCAYL_NCNN_URL
RUN mkdir -p /opt/upscayl /app/models /app/io/input /app/io/output \
    && curl -fSL "$UPSCAYL_NCNN_URL" -o /tmp/u.zip \
    && unzip -q /tmp/u.zip -d /opt/upscayl && rm /tmp/u.zip \
    && BIN="$(find /opt/upscayl -type f -name 'realesrgan-ncnn-vulkan' | head -1)" \
    && ln -s "$BIN" /usr/local/bin/realesrgan-ncnn-vulkan \
    && chmod +x "$BIN" \
    && MODELS="$(dirname "$(find /opt/upscayl -type f -name '*.param' | head -1)")" \
    && cp -a "$MODELS"/. /app/models/

COPY upscayl/requirements.txt /app/requirements.txt
RUN pip3 install --no-cache-dir -r /app/requirements.txt
COPY upscayl/ /app/

# Vulkan needs the 'graphics' capability or the NVIDIA ICD is not exposed.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all \
    MODELS_DIR=/app/models \
    INPUT_ROOT=/app/io/input \
    OUTPUT_ROOT=/app/io/output
WORKDIR /app
EXPOSE 8081
# Bind to loopback only: the API reaches it via localhost (host networking),
# but external hosts cannot, even if the host port is exposed.
CMD ["waitress-serve", "--listen=127.0.0.1:8081", "app:app"]
