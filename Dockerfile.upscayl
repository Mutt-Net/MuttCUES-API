FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip libvulkan1 vulkan-tools libgomp1 \
        libx11-6 libxext6 libgl1 \
        unzip curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Prebuilt upscayl-ncnn binary (fork of realesrgan-ncnn-vulkan; same CLI flags).
# The release zip ships ONLY the binary — models are provisioned separately into
# the upscayl-models volume (see scripts/provision_models.sh).
ARG UPSCAYL_NCNN_URL=https://github.com/upscayl/upscayl-ncnn/releases/download/20251207-174704/upscayl-bin-20251207-174704-linux.zip
RUN mkdir -p /opt/upscayl /app/models /app/io/input /app/io/output \
    && curl -fSL "$UPSCAYL_NCNN_URL" -o /tmp/u.zip \
    && unzip -q /tmp/u.zip -d /opt/upscayl && rm /tmp/u.zip \
    && BIN="$(find /opt/upscayl -type f -name 'upscayl-bin' | head -1)" \
    && install -m 0755 "$BIN" /usr/local/bin/upscayl-bin

COPY upscayl/requirements.txt /app/requirements.txt
RUN pip3 install --no-cache-dir -r /app/requirements.txt
COPY upscayl/ /app/

# Vulkan needs the 'graphics' capability or the NVIDIA ICD is not exposed.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all \
    UPSCAYL_BINARY=upscayl-bin \
    MODELS_DIR=/app/models \
    INPUT_ROOT=/app/io/input \
    OUTPUT_ROOT=/app/io/output
WORKDIR /app
EXPOSE 8081
# Listen on all interfaces so muttcues-api can reach it over the Docker bridge.
# Isolation comes from NOT publishing this port in compose — only services on the
# muttnet bridge can reach it; app-level path/model validation guards it too.
CMD ["waitress-serve", "--listen=*:8081", "app:app"]
