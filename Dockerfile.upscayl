FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
# CUDA Real-ESRGAN sidecar. This host's containerized Vulkan is broken (NVIDIA
# driver-580 ICD won't init in any container) but CUDA/compute works, so we run
# Real-ESRGAN via PyTorch on the GPU instead of the Vulkan upscayl-ncnn binary.
# Hence we request ONLY compute,utility — not graphics — avoiding the broken
# Vulkan injection entirely. libgl1/libglib2.0-0 are for Pillow image I/O.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip curl ca-certificates libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Torch with bundled CUDA 12.4 runtime (works with driver 580); the host driver
# (libcuda) is injected by nvidia-container-toolkit at run time.
RUN pip3 install --no-cache-dir --break-system-packages \
        --index-url https://download.pytorch.org/whl/cu124 \
        torch torchvision

COPY upscayl/requirements.txt /app/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /app/requirements.txt

# Real-ESRGAN PyTorch weights. spandrel auto-detects the architecture from the
# .pth; drop additional ESRGAN/NMKD weights into the models volume to use them
# by filename stem (e.g. 4x_NMKD-Superscale-SP_178000_G.pth).
RUN mkdir -p /app/models /app/io/input /app/io/output \
    && curl -fSL https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth \
        -o /app/models/RealESRGAN_x4plus.pth \
    && curl -fSL https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.1/RealESRGAN_x2plus.pth \
        -o /app/models/RealESRGAN_x2plus.pth

COPY upscayl/ /app/

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    MODELS_DIR=/app/models \
    INPUT_ROOT=/app/io/input \
    OUTPUT_ROOT=/app/io/output
WORKDIR /app
EXPOSE 8081
# Listen on all interfaces so muttcues-api can reach it over the Docker bridge.
# Isolation comes from NOT publishing this port in compose — only services on the
# muttnet bridge can reach it; app-level path/model validation guards it too.
CMD ["waitress-serve", "--listen=*:8081", "app:app"]
